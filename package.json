{
    "name": "monorepo",
    "private": true,
    "scripts": {
        "cli": "pnpm --filter happy cli",
        "release": "node ./scripts/release.cjs",
        "web": "pnpm --filter happy-app web",
        "app-logs": "pnpm --filter happy-app-logs start",
        "mobile-gym": "pnpm --filter happy-mobile-gym cli",
        "screenshots:compose": "node scripts/app-store/compose.mjs",
        "screenshots:capture:android": "node scripts/app-store/android-capture.mjs",
        "postinstall": "node ./scripts/postinstall.cjs",
        "env:new": "tsx packages/dev-environments/environments.ts new",
        "env:list": "tsx packages/dev-environments/environments.ts list",
        "env:use": "tsx packages/dev-environments/environments.ts use",
        "env:remove": "tsx packages/dev-environments/environments.ts remove",
        "env:current": "tsx packages/dev-environments/environments.ts current",
        "env:server": "tsx packages/dev-environments/environments.ts run server",
        "env:web": "tsx packages/dev-environments/environments.ts run web",
        "env:ios": "tsx packages/dev-environments/environments.ts run ios",
        "env:android": "tsx packages/dev-environments/environments.ts run android",
        "env:cli": "tsx packages/dev-environments/environments.ts run cli",
        "env:seed": "tsx packages/dev-environments/environments.ts seed",
        "env:up": "tsx packages/dev-environments/environments.ts up",
        "env:up:authenticated": "pnpm env:up --template authenticated-empty",
        "env:down": "tsx packages/dev-environments/environments.ts down",
        "env:tailscale": "tsx packages/dev-environments/environments.ts tailscale"
    },
    "workspaces": {
        "packages": [
            "packages/happy-app",
            "packages/happy-agent",
            "packages/happy-cli",
            "packages/happy-server",
            "packages/happy-server-self-host",
            "packages/happy-wire",
            "packages/happy-app-logs",
            "packages/happy-mobile-gym",
            "packages/expo-tailcat",
            "packages/happy-push-server"
        ]
    },
    "pnpm": {
        "overrides": {
            "whatwg-url": "14.2.0",
            "parse-path": "7.0.3",
            "@types/parse-path": "7.0.3",
            "ws@7.x": "7.5.13",
            "ws@8.x": "8.21.3",
            "follow-redirects@1.x": "1.16.0",
            "socket.io-parser@4.x": "4.2.7",
            "shell-quote@1.x": "1.10.0",
            "fast-uri@3.x": "3.1.7",
            "ajv@8.x": "8.20.0",
            "picomatch@2.x": "2.3.2",
            "yaml@2.x": "2.9.0",
            "hono@4.x": "4.13.7",
            "@hono/node-server@1.x": "1.19.17",
            "path-to-regexp@8.x": "8.4.2",
            "qs@6.x": "6.16.0",
            "body-parser@2.x": "2.3.0",
            "ip-address@10.x": "10.7.0",
            "effect@3.x": "3.22.2",
            "defu@6.x": "6.1.7"
        },
        "onlyBuiltDependencies": [
            "@more-tech/react-native-libsodium",
            "@prisma/client",
            "@prisma/engines",
            "@shopify/react-native-skia",
            "@tailwindcss/oxide",
            "better-sqlite3",
            "esbuild",
            "prisma",
            "sharp",
            "workerd"
        ]
    },
    "devDependencies": {
        "playwright": "1.61.1",
        "sharp": "^0.35.3",
        "tsx": "^4.20.6"
    },
    "packageManager": "pnpm@10.11.0"
}
